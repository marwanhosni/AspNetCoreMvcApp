@model EmployeeViewModel
@{
    ViewData["Title"] = "Updates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit Employee</h1>
<br />
<br />
<form asp-controller="Employee" asp-action="Edit" method="post" enctype="multipart/form-data">

    <partial name="EmployeePartialView/CreateEditPartialView" model="@Model" />

    <input type="hidden" asp-for="ImageName" />

    <input type="submit" value="Save" class="btn btn-primary" />
    <a asp-controller="Employee" asp-action="Index" class="btn btn-light">Back To List</a>
</form>

@section ValidationScriptSection {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}


@section ValidationSection {

    <partial name="_ValidationScriptsPartial" />

   @*  <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script> *@

}

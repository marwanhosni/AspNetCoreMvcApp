@model RoleViewModel
@{
    ViewData["Title"] = "Updates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit Role</h1>
<br />
<br />
<form  asp-action="Edit" method="post" enctype="multipart/form-data">

    <partial name="RolePartialView/CreateEditPartialView" model="@Model" />

    <a asp-action="AddOrRemoveRole" asp-route-id="@Model.Id" class="btn btn-success">AddOrRemoveRole</a>

    <input type="submit" value="Save" class="btn btn-primary" />
    <a  asp-action="Index" class="btn btn-light">Back To List</a>
</form>

@section ValidationScriptSection {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}


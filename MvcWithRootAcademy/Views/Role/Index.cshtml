@model IEnumerable<RoleViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<h1>All Role</h1>
<br />
<br />
<form asp-action="Index" class="row col-8">
    <div class="col-8">
        <input type="text" class="form-control" name="SearchInput" id="SearchInput" placeholder="Search By Name" />
    </div>

    <div class="col-4">
        <input type="submit" value="Search" class="btn btn-success" />
    </div>
</form>
<br />



<a asp-controller="Role" asp-action="Create" class="btn btn-primary">Create Role</a>

@if (Model.Count() > 0)
{
    <table class="table table-striped table-hover">

        <thead>
            <tr>
                <th>@Html.DisplayNameFor(R => R.Id)</th>
                <th>@Html.DisplayNameFor(R => R.Name)</th>
            
                <th>Details</th>
                <th>Updates</th>
                <th>Delete</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var Roles in Model)
            {
                <tr>

                    <td>@Roles.Id</td>
                    <td>@Roles.Name</td>
                 
   
                    <partial name="_ButtonsPartialView" model="@Roles.Id" />
                </tr>
            }

        </tbody>

    </table>
}
else
{
    <div class="mt-4 alert alert-warning">
        <h4>There is No Roles :</h4>
    </div>
}





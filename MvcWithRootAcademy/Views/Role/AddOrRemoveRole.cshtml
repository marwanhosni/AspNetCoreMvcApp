@model IList<UserInRoleViewModel>
@{
    ViewData["Title"] = "AddOrRemoveRole";
    Layout = "~/Views/Shared/_Layout.cshtml";
	var RoleId = ViewData["RoleId"];
}

<h1>AddOrRemoveRole</h1>
<form asp-action="AddOrRemoveRole" asp-route-id="@RoleId">
 @for(int i = 0; i < Model.Count ; i++)
{
<div class="form-group">
    <input asp-for="@Model[i].IsSelected">
    <label asp-for="@Model[i].IsSelected"> @Model[i].UserName</label>

    <input type="hidden" asp-for="@Model[i].UserId">
    <input type="hidden" asp-for="@Model[i].UserName">

</div>
}
<input type="submit" value="Update" class="btn btn-secondary">
    <a asp-action="Edit" asp-route-id="@RoleId" class="btn btn-light"> Cancel </a>
</form>


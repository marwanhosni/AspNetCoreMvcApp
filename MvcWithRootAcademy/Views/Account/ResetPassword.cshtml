@model ResetPasswordViewModel
@{
    ViewData["Title"] = "ResetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
	<div class="agileits-top">
		<div asp-validation-summary="All">
		</div>
		<form asp-action="ResetPassword" method="post">
			<input class="text" asp-for="NewPassword" placeholder="Password" required="">
			<input class="text w3lpass" asp-for="ConfirmNewPassword" placeholder="Confirm Password" required="">
			
			<input type="submit" value="SignIn">
		</form>
		<p>Don't have an Account? <a asp-for="SignIn"> Login Now!</a></p>
	</div>
</div>


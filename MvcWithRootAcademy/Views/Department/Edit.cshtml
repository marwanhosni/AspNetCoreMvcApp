@model DepartmentViewModel
@{
    ViewData["Title"] = "Updates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit Department</h1>
<br />
<br />
<form asp-controller="Department"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post">

    <input type="hidden" asp-for="Id" />

    <partial name="DepartmentPartialView/CreateEditPartialView" model="Model" />


    <input type="submit" value="Save" class="btn btn-primary" />
    <a asp-controller="Department" asp-action="Index" class="btn btn-light">Back To List</a>
</form>

@section ValidationScriptSection {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}



@section ValidationSection {

    <partial name="_ValidationScriptsPartial" />

    @* <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script> *@

}